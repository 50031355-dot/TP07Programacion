@model TP07.Models.Usuario
@{
    ViewData["Title"] = "Registro de Usuario";
}

<div class="registro-container">
    <div class="registro-card">
        <h2>Registro de Usuario</h2>
        
        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                <h2>Error</h2>
                <p>@ViewBag.Error</p>
            </div>
        }
        
        <form method="post" action="@Url.Action("Registro", "Home")" class="registro-form">
            <div class="form-group">
                <label for="nombreUsuario">Nombre de Usuario</label>
                <input type="text" id="nombreUsuario" name="nombreUsuario" required />
            </div>
            
            <div class="form-group">
                <label for="nombre">Nombre</label>
                <input type="text" id="nombre" name="nombre" required />
            </div>
            
            <div class="form-group">
                <label for="apellido">Apellido</label>
                <input type="text" id="apellido" name="apellido" required />
            </div>
            
            <div class="form-group">
                <label for="contraseña">Contraseña</label>
                <input type="password" id="contraseña" name="contraseña" required />
            </div>
            
            <button type="submit" class="registro-btn">Registrarse</button>
            <a href="@Url.Action("Login", "Home")">Volver al Login</a>
        </form>
    </div>
</div>